@using MudBlazor
@using WorkBoard.UI.Components.Card

<MudDialog DefaultFocus="DefaultFocus.None"
           Class="rounded-xl"
           ContentClass="pa-0 py-0 overflow-hidden d-flex flex-column"
           Style="height: 85vh; max-height: 900px;">
    <DialogContent>
        <div class="px-6 pt-6 pb-2 flex-shrink-0">
            <MudIconButton Icon=@Icons.Material.Rounded.Close
                           OnClick=@Close
                           Size=@Size.Small
                           Class="position-absolute text-muted"
                           Style="top: 16px; right: 16px;" />

            <div class="d-flex align-center gap-2 mb-0">
                <MudText Typo=@Typo.caption
                         Class="text-muted font-weight-bold">SECTION:</MudText>

                <MudChip Value=@("Status")
                         T="string"
                         Size=@Size.Small
                         Color=@Color.Info
                         Variant=@Variant.Text
                         Class="font-weight-bold border-solid border mud-border-info">
                    @Card.Status
                </MudChip>
            </div>

            <div class="mb-3 pr-8">
                <MudTextField @bind-Value=@_editedTitle
                              Placeholder="Task name..."
                              Class="@($"task-title-input mt-0 pa-0 {(!_isEditingTitle ? "hide-underline" : "")}")"
                              MaxLength="100"
                              @onfocus=@(() => _isEditingTitle = true)
                              @onclick=@(() => _isEditingTitle = true)
                              @onblur=@OnTitleBlurAsync
                              Immediate="true" />

                @if (_isEditingTitle)
                {
                    <div class="d-flex gap-2 mt-2 justify-start">
                        <MudButton Variant=@Variant.Filled
                                   Color=@Color.Primary
                                   Size=@Size.Small
                                   Class="rounded-lg text-none custom-btn popover-action-btn"
                                   OnClick=@SaveTitleAsync
                                   Disabled=@string.IsNullOrWhiteSpace(_editedTitle)>
                            Save
                        </MudButton>

                        <MudButton Variant=@Variant.Filled
                                   Color=@Color.Surface
                                   Size=@Size.Small
                                   Class="rounded-lg text-none text-btn popover-action-btn"
                                   DropShadow="false"
                                   OnClick=@DiscardTitleChanges>
                            Cancel
                        </MudButton>
                    </div>
                }
            </div>

            <CardLabelsSection CardId=@Card.Id
                               BoardId=@Card.BoardId
                               @bind-AppliedLabels="_cardLabels" />
        </div>

        <MudDivider Class="mx-0" />

        <div class="flex-grow-1 d-flex overflow-hidden">
            <div @ref="_mainContentScroll" 
                 class="mud-background-gray flex-grow-1 overflow-y-auto custom-scrollbar pl-6 pr-6 pb-6 pt-2 bg-white card-main-content">
                <div class="mb-6 mt-2">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon=@Icons.Material.Outlined.Description
                                 Size=@Size.Small
                                 Class="text-muted" />

                        <MudText Typo=@Typo.subtitle2
                                 Class="font-weight-bold text-muted">Description</MudText>
                    </div>

                    <div>
                        <MudTextField @bind-Value=@_editedDescription
                                      Variant=@Variant.Outlined
                                      MultiLine="true"
                                      Lines="4"
                                      Placeholder="Add a more detailed description..."
                                      Class="custom-input"
                                      @onfocus=@(() => _isEditingDescription = true)
                                      @onclick=@(() => _isEditingDescription = true)
                                      @onblur=@OnDescriptionBlurAsync
                                      Immediate="true" />

                        @if (_isEditingDescription)
                        {
                            <div class="d-flex gap-2 mt-2 justify-start">
                                <MudButton Variant=@Variant.Filled
                                           Color=@Color.Primary
                                           Size=@Size.Small
                                           Class="rounded-lg text-none custom-btn popover-action-btn"
                                           @onmousedown=@SaveDescriptionAsync>
                                    Save
                                </MudButton>

                                <MudButton Variant=@Variant.Filled
                                           Color=@Color.Surface
                                           Size=@Size.Small
                                           Class="rounded-lg text-none text-btn popover-action-btn"
                                           DropShadow="false"
                                           @onmousedown=@DiscardDescriptionChanges>
                                    Cancel
                                </MudButton>
                            </div>
                        }
                    </div>
                </div>

                <CardAssigneesSection CardId="@Card.Id"
                                      AssignableUsers="@_assignableUsers"
                                      @bind-Assignees="@_assignees" />

                <ChecklistSection CardId="@Card.Id"
                                  @bind-Checklist="_checklist" />

                <MudDivider Style="border-color: rgba(0, 0, 0, 0.4) !important;" />

                <div class="mt-3 mb-2">
                    <MudTabs Elevation="0" 
                             Color=@Color.Transparent
                             SliderColor=@Color.Primary
                             Class="clean-tabs" 
                             KeepPanelsAlive="false"
                             PanelClass="pt-4">

                        <MudTabPanel Text="@($"Comments ({_commentsCount})")"
                                     Class="tab-title-text" 
                                     Icon=@Icons.Material.Outlined.ChatBubbleOutline
                                     KeepPanelsAlive="true">

                            <CommentsSection CardId="@Card.Id"
                                             CurrentUserId="@CurrentUserId"
                                             Comments="@_comments"
                                             CommentsCountChanged="@UpdateCommentsCount" />

                        </MudTabPanel>

                        <MudTabPanel Text="Activity Log" 
                                     Class="tab-title-text" 
                                     Icon=@Icons.Material.Outlined.ShowChart>

                            <ActivityLogSection CardId="@Card.Id"
                                                @bind-ActivityLogs="_activityLogs" />
                        </MudTabPanel>

                    </MudTabs>
                </div>

            </div>

            <div class="mud-background-gray d-flex flex-column overflow-hidden pl-6 pr-6 pb-6 pt-2 border-l-solid border-l-2 mud-border-lines-default card-sidebar">
                <div class="mb-6 mt-2 flex-shrink-0">
                    <MudText Typo=@Typo.body2 Class="text-muted d-flex align-center gap-2 mb-1">
                        <MudIcon Icon=@Icons.Material.Outlined.CalendarToday Size=@Size.Small /> Due Date
                    </MudText>

                    @if (!_isPickerLoaded)
                    {
                        <div class="position-relative click-wrapper" @onclick="LoadAndOpenPicker">

                            <MudTextField T="string"
                                          Value="@(_dueDate.HasValue ? _dueDate.Value.ToString("dd MMM yyyy") : null)"
                                          Placeholder="Set due date..."
                                          ReadOnly="true"
                                          Variant=@Variant.Outlined
                                          Margin=@Margin.Dense
                                          Adornment=@Adornment.Start
                                          AdornmentIcon=@Icons.Material.Outlined.AccessTime
                                          Class="@($"click-wrapper fake-picker mt-2 {(!_dueDate.HasValue ? "text-muted" : _dueDate.Value < DateTime.Now ? "due-date-error" : "due-date-warning")}")" />

                            @if (_dueDate.HasValue)
                            {
                                <div class="position-absolute"
                                     style="right: 6px; top: 50%; transform: translateY(-50%); z-index: 10;"
                                     @onclick:stopPropagation="true">

                                    <MudIconButton Icon=@Icons.Material.Rounded.Close
                                                   Size=@Size.Small
                                                   Class="text-muted pa-1"
                                                   OnClick="@(async () => await OnDueDateChangedAsync(null))" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <MudDatePicker @ref="_datePicker"
                                       Date=@_dueDate
                                       DateChanged=@(async (DateTime? newDate) => { await OnDueDateChangedAsync(newDate); _isPickerLoaded = false; })
                                       Editable="false"
                                       AutoClose="true"
                                       ShowToolbar="false"
                                       Variant=@Variant.Outlined
                                       Margin=@Margin.Dense
                                       DateFormat="dd MMM yyyy"
                                       Adornment=@Adornment.Start
                                       AdornmentIcon=@Icons.Material.Outlined.AccessTime
                                       Clearable="true"
                                       Class="@($"click-wrapper {(!_dueDate.HasValue ? "text-muted" : _dueDate.Value < DateTime.Now ? "due-date-error" : "due-date-warning")}")" />
                    }
                </div>

                <CardAttachmentsSection CardId="@Card.Id"
                                        @bind-Attachments="_attachments" />

                <MudButton Variant=@(_isPendingDeleteCard ? Variant.Filled : Variant.Outlined)
                           Color=@Color.Error
                           StartIcon=@(_isPendingDeleteCard ? Icons.Material.Filled.DeleteForever : Icons.Material.Outlined.Delete)
                           Class="w-100 rounded-lg mt-4 flex-shrink-0 transition-all"
                           OnClick=@(async () => { 
                               if (_isPendingDeleteCard) 
                               {
                                   await ConfirmDeleteCardAsync();
                               }
                               else
                               {
                                   _isPendingDeleteCard = true; 
                               }
                           }) 
                           @onmouseleave=@(() => _isPendingDeleteCard = false)>
                    @(_isPendingDeleteCard ? "Confirm Delete?" : "Delete Card")
                </MudButton>

            </div>
        </div>
    </DialogContent>
</MudDialog>

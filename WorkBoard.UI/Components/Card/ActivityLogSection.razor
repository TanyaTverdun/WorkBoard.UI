@using MudBlazor

@if (!ActivityLogs.Any())
{
    <MudText Typo=@Typo.body2 Class="text-muted mt-4">
        Activity history will appear here.
    </MudText>
}
else
{
    <div class="mt-4 pr-4 pl-5 overflow-y-auto custom-scrollbar" style="max-height: 400px;">
        @foreach (var log in ActivityLogs)
        {
            <div class="py-2">
                <div class="d-flex align-start gap-2">

                    <div class="d-flex align-center gap-1 flex-shrink-0 mt-1">
                        <MudAvatar Size=@Size.Small
                                   Style=@($"background-color: {(string.IsNullOrEmpty(log.AvatarColor) ? "#64748b" : log.AvatarColor)}; color: white;")>
                            @if (!string.IsNullOrEmpty(log.AvatarUrl))
                            {
                                <img src=@log.AvatarUrl
                                     alt="Profile Avatar"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                @(log.Initials ?? "??")
                            }
                        </MudAvatar>
                    </div>

                    <MudText Typo=@Typo.body2
                             Class="font-weight-medium flex-grow-1"
                             Style="word-break: break-word; min-width: 0; line-height: 1.5;">
                        @log.Text
                    </MudText>
                </div>

                <MudText Typo=@Typo.caption
                         Class="text-muted">
                    @log.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")
                </MudText>
            </div>
        }
    </div>
}
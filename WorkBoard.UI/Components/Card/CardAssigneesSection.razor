@using MudBlazor

<div class="mb-6">
    <div class="d-flex align-center gap-2 mb-2">
        <MudIcon Icon=@Icons.Material.Outlined.People
                 Size=@Size.Small
                 Class="text-muted" />

        <MudText Typo=@Typo.subtitle2
                 Class="font-weight-bold text-muted">Assignees</MudText>
    </div>

    <div class="d-flex flex-wrap gap-2 position-relative">

        @foreach (var assignee in _assignees)
        {
            <MudPaper @key="assignee.UserId"
                      Elevation="0"
                      Class="d-flex align-center rounded-pill px-2 gap-2 border-solid border bg-transparent"
                      Style="border: 1px solid rgba(0, 0, 0, 0.2) !important; height: 4.5vh">

                <MudAvatar Size="Size.Small" Color="Color.Tertiary">
                    @assignee.Initials
                </MudAvatar>

                <MudText Typo="Typo.body2" Class="font-weight-medium text-truncate" Style="max-width: 150px;">
                    @assignee.FullName
                </MudText>

                <MudIconButton Icon="@Icons.Material.Rounded.Close"
                               Size="Size.Small"
                               Class="pa-0 text-muted"
                               OnClick="@(() => RemoveAssigneeAsync(assignee))" />
            </MudPaper>
        }

        <MudButton Variant=@Variant.Outlined
                   Size=@Size.Small
                   StartIcon=@Icons.Material.Rounded.Add
                   Class="rounded-pill border-dashed text-muted px-4 text-none"
                   Style="text-transform: none"
                   OnClick=@(() => _isPopoverOpen = !_isPopoverOpen)>
            Add member
        </MudButton>

        <MudPopover Open=@_isPopoverOpen
                    AnchorOrigin=@Origin.BottomLeft
                    TransformOrigin=@Origin.TopLeft
                    Class="pa-3 mud-elevation-4 rounded-lg mt-1"
                    Style="width: 280px; z-index: 9999;">

            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo=@Typo.caption
                         Class="text-muted font-weight-bold text-uppercase">Assign Member</MudText>

                <MudIconButton Icon=@Icons.Material.Filled.Close
                               Size=@Size.Small
                               OnClick=@(() => _isPopoverOpen = false)
                               Class="pa-0" />
            </div>

            <MudTextField @bind-Value=@_searchText
                          Placeholder="Search by email or name..."
                          Variant=@Variant.Outlined
                          Margin=@Margin.Dense
                          Adornment=@Adornment.Start
                          AdornmentIcon=@Icons.Material.Filled.Search
                          Size="Size.Small"
                          Class="mb-2 bg-white rounded-lg compact-input"
                          Immediate="true" />

            <div class="d-flex flex-column gap-1 overflow-y-auto custom-scrollbar assignee-list-scroll">
                @foreach (var member in FilteredAssignableUsers)
                {
                    var isAssigned = _assignees.Any(a => a.Email == member.Email);

                    <div @key=@member.UserId
                         class="d-flex align-center gap-3 pa-2 rounded-lg cursor-pointer mud-ripple assignee-row"
                         @onclick=@(() => ToggleAssigneeAsync(member))>

                        <MudAvatar Size=@Size.Medium
                                   Color=@Color.Tertiary
                                   Class="assignee-avatar">
                            @member.Initials
                        </MudAvatar>

                        <div class="d-flex flex-column flex-grow-1">
                            <MudText Typo=@Typo.body2
                                     Class="font-weight-medium assignee-name">@member.FullName</MudText>

                            <MudText Typo=@Typo.caption
                                     Class="text-muted font-weight-medium">@member.Email</MudText>
                        </div>

                        @if (isAssigned)
                        {
                            <MudIcon Icon=@Icons.Material.Rounded.Check
                                     Size=@Size.Small
                                     Color=@Color.Info
                                     Class="mr-1" />
                        }
                    </div>
                }

                @if (!FilteredAssignableUsers.Any())
                {
                    <MudText Typo=@Typo.caption
                             Class="text-muted text-center py-3">No members found</MudText>
                }
            </div>
        </MudPopover>

        <MudOverlay Visible=@_isPopoverOpen
                    OnClick=@(() => _isPopoverOpen = false)
                    AutoClose="true"
                    ZIndex="9998" />
    </div>
</div>
@using WorkBoard.Domain.Enums
@using WorkBoard.UI.Components.Workspaces.Modal

@inherits Microsoft.AspNetCore.Components.ComponentBase

<div class="workspaces-section">
    <div class="sidebar-header d-flex align-items-center justify-content-between" 
         @onclick=@ToggleDropdown>
        <h3 class="sidebar-title">WORKSPACES</h3>

        <i class="bi bi-chevron-down arrow-icon @(_isDropdownOpen ? "open" : "")"></i>
    </div>

    <div class="dropdown-content @(_isDropdownOpen ? "show" : "")">
        @if (Workspaces == null)
        {
            <div class="loading-text text-muted small px-3">loading...</div>
        }
        else
        {
            <ul class="workspace-list list-unstyled m-0">
                @foreach (var space in Workspaces)
                {
                    <li class="workspace-item d-flex align-items-center justify-content-between py-1 px-2 my-1 rounded @(SelectedWorkspaceId == space.Id ? "active" : "")"
                        @onclick="() => SelectWorkspace(space.Id)">

                        <div class="d-flex align-items-center gap-2 text-truncate">
                            <i class="bi bi-briefcase-fill workspace-icon"></i>
                            <span class="workspace-name text-truncate">@space.Name</span>
                        </div>

                        @if (space.UserRole == WorkspaceRole.Owner)
                        {
                            <div class="workspace-actions d-flex align-items-center gap-1.5" 
                                @onclick:stopPropagation>
                                <button class="btn-action edit-action"
                                        title="Edit Workspace"
                                        @onclick="() => OpenEditModal(space)">
                                    <i class="bi bi-pencil-fill"></i>
                                </button>

                                <button class="btn-action delete-action"
                                        title="Delete Workspace"
                                        @onclick="() => OpenDeleteModal(space)">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        }
                    </li>
                }
            </ul>
        }

        <button class="btn-new-workspace d-flex align-items-center gap-2 mt-1" 
                @onclick=@OpenCreateModal>
            <i class="bi bi-plus-lg"></i>
            <span>New Workspace</span>
        </button>
    </div>
</div>

<WorkspaceModal IsOpen=@_isCreateModalOpen
                WorkspaceId=@_workspaceToModify?.Id
                InitialName=@_workspaceToModify?.Name
                OnClose=@CloseCreateModal
                OnWorkspaceSaved=@HandleWorkspaceSavedAsync />

<DeleteWorkspaceModal IsOpen=@_isDeleteModalOpen
                      Workspace=@_workspaceToModify
                      OnClose=@CloseDeleteModal
                      OnWorkspaceDeleted=@HandleWorkspaceDeletedAsync />
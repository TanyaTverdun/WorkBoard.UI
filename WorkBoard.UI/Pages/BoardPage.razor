@page "/boards/{BoardIdGuid:guid}"

@using Microsoft.AspNetCore.Components
@using WorkBoard.Domain.Enums
@using WorkBoard.Services.Abstraction.DTOs.Users
@using WorkBoard.UI.ViewModels.Board

<div class="d-flex flex-column">
	<div class="d-flex align-center justify-space-between py-3 px-5 gap-3 mb-6 board-header">
		<div class="d-flex gap-4">
			<MudText Typo=@Typo.h6
					 Class="font-weight-bold mr-2">
				@BoardStateService.CurrentBoardName
			</MudText>

			<div class="d-flex align-center pl-4">

				<MudIconButton Icon=@Icons.Material.Rounded.PersonAddAlt1
							   Size=@Size.Small
							   Class="ml-2 text-muted mx-3"
							   OnClick=@OpenManageMembersDialog />

				<MudAvatarGroup Max="5"
								Spacing="2"
								MaxColor=@Color.Dark
								Class="cursor-pointer"
								@onclick=@OpenManageMembersDialog>
					@if (_boardMembers != null)
					{
						@foreach (var member in _boardMembers)
						{
							<MudAvatar Size="@Size.Small"
									   Class="member-avatar-small"
									   Style=@($"background-color: {(string.IsNullOrEmpty(member.Dto.AvatarColor) ? "#64748b" : member.Dto.AvatarColor)}; color: white;")>
								@if (!string.IsNullOrEmpty(member.Dto.AvatarUrl))
								{
									<img src=@member.Dto.AvatarUrl
										 alt="Profile Avatar"
										 style="width: 100%; height: 100%; object-fit: cover;" />
								}
								else
								{
									@(member.Dto.Initials ?? "??")
								}
							</MudAvatar>
						}
					}
				</MudAvatarGroup>

				<MudPopover Open=@_isMembersPopoverOpen
							AnchorOrigin=@Origin.BottomRight
							TransformOrigin=@Origin.TopRight
							Class="pa-4 pt-2 mud-elevation-25 rounded-lg members-popover">

					<div class="d-flex justify-space-between align-center mb-4">
						<MudText Typo=@Typo.subtitle1
								 Class="font-weight-bold text-dark">Board Members</MudText>

						<MudIconButton Icon=@Icons.Material.Rounded.Close
									   Size=@Size.Small
									   OnClick=@CloseManageMembersDialog
									   Class="text-muted" />
					</div>

					<MudDivider Class="mb-3" />

					<div class="d-flex flex-column gap-3 mb-4 overflow-y-auto pr-1 members-scroll-area">

						@if (_boardMembers != null)
						{
							@foreach (var member in _boardMembers)
							{
								<div class="d-flex align-center justify-space-between py-1 px-2 @(member.IsConfirmingDelete ? "member-row-delete" : "")">

									<div class="d-flex align-center gap-3 overflow-hidden">
										<MudAvatar Size="@Size.Small"
												   Class="member-avatar-small"
												   Style=@($"background-color: {(string.IsNullOrEmpty(member.Dto.AvatarColor) ? "#64748b" : member.Dto.AvatarColor)}; color: white;")>
											@if (!string.IsNullOrEmpty(member.Dto.AvatarUrl))
											{
												<img src=@member.Dto.AvatarUrl
													 alt="Profile Avatar"
													 style="width: 100%; height: 100%; object-fit: cover;" />
											}
											else
											{
												@(member.Dto.Initials ?? "??")
											}
										</MudAvatar>

										<div class="d-flex flex-column overflow-hidden">
											<MudText Typo=@Typo.body2
													 Class="text-truncate"
													 Color=@(member.IsConfirmingDelete ? Color.Error : Color.Default)>
												@member.Dto.FullName
											</MudText>

											@if (member.IsConfirmingDelete)
											{
												<MudText Typo=@Typo.caption
														 Color=@Color.Error
														 Class="caption-small">Remove from board?</MudText>
											}
											else
											{
												<MudText Typo=@Typo.caption
														 Class="text-muted text-truncate caption-small">@member.Dto.Email</MudText>
											}
										</div>
									</div>

									<div class="d-flex align-center gap-1 member-actions-wrapper">
										@if (member.IsConfirmingDelete)
										{
											<div class="d-flex align-center gap-1">
												<MudButton Variant=@Variant.Filled
														   Color=@Color.Error
														   Size=@Size.Small
														   Class="btn-remove-small"
														   OnClick=@(async () => await RemoveMemberAsync(member))>
													Remove
												</MudButton>

												<MudIconButton Icon=@Icons.Material.Filled.Close
															   Size=@Size.Small
															   OnClick=@(() => member.IsConfirmingDelete = false) />
											</div>
										}
										else
										{
											<div class="menu-wrapper @(_currentUserId == member.Dto.UserId ? "is-open" : "")">
												<MudSelect T=@BoardRole
														   Value=@member.Dto.UserRole
														   ValueChanged=@(async (r) => await UpdateRoleAsync(member, r))
														   Dense="true"
														   Disabled=@(member.Dto.UserId == _currentUserId || IsCurrentUserObserver)
														   Variant=@Variant.Outlined
														   Margin=@Margin.Dense
														   Class="role-select seagreen"
														   PopoverClass="custom-dropdown-popover">
													<MudSelectItem Value=@BoardRole.Member>Member</MudSelectItem>

													<MudSelectItem Value=@BoardRole.Observer>Observer</MudSelectItem>
												</MudSelect>
											</div>

											<MudIconButton Icon=@Icons.Material.Rounded.PersonRemove
														   Size=@Size.Small
														   Disabled=@(member.Dto.UserId == _currentUserId || IsCurrentUserObserver)
														   Class="text-muted hover-error-btn"
														   OnClick=@(() => member.IsConfirmingDelete = true) />
										}
									</div>
								</div>
							}
						}
					</div>

					@if (!IsCurrentUserObserver)
					{
						<MudDivider Class="mb-3" />

						<MudText Typo=@Typo.caption
								 Class="text-muted font-weight-bold d-flex align-center gap-1 mb-2 add-member-header">
							<MudIcon Icon=@Icons.Material.Outlined.Email
									 Size=@Size.Small
									 Class="add-member-icon" /> ADD MEMBER BY EMAIL
						</MudText>

						<div class="d-flex flex-column gap-2">
							<MudAutocomplete T=@UserSearchDto
											 @bind-Value=@_selectedUserToAdd
											 AdornmentIcon=@Icons.Material.Filled.Close
											 IconSize=@Size.Small
											 SearchFunc=@SearchUsersAsync
											 ToStringFunc=@(user => user == null ? null : user.Email)
											 Placeholder="Type email..."
											 Variant=@Variant.Outlined
											 Margin=@Margin.Dense
											 Class="compact-input"
											 ResetValueOnEmptyText="true"
											 MinCharacters="2"
											 ShowProgressIndicator="true">
								<ItemTemplate Context="user">
									<div class="d-flex align-center gap-3 py-1">
										<MudAvatar Size="@Size.Small"
												   Class="avatar-tiny"
												   Style=@($"background-color: {(string.IsNullOrEmpty(user.AvatarColor) ? "#64748b" : user.AvatarColor)}; color: white;")>
											@if (!string.IsNullOrEmpty(user.AvatarUrl))
											{
												<img src=@user.AvatarUrl
													 alt="Profile Avatar"
													 style="width: 100%; height: 100%; object-fit: cover;" />
											}
											else
											{
												@(user.Initials ?? "??")
											}
										</MudAvatar>

										<div class="d-flex flex-column">
											<MudText Typo=@Typo.body2
													 Class="font-weight-medium">@user.FullName</MudText>

											<MudText Typo=@Typo.caption
													 Class="text-muted text-xs-tight">@user.Email</MudText>
										</div>
									</div>
								</ItemTemplate>
							</MudAutocomplete>

							<div class="d-flex gap-3 align-center">
								<MudSelect T=@BoardRole @bind-Value=@_newMemberRole
										   Dense="true"
										   Variant=@Variant.Outlined
										   Margin=@Margin.Dense
										   Class="flex-grow-1 compact-input role-select"
										   PopoverClass="custom-dropdown-popover">
									<MudSelectItem Value=@BoardRole.Member>Member</MudSelectItem>
									<MudSelectItem Value=@BoardRole.Observer>Observer</MudSelectItem>
								</MudSelect>

								<MudButton Variant=@Variant.Filled
										   Color=@Color.Primary
										   OnClick=@AddMemberAsync
										   Class="custom-btn rounded-lg btn-add-compact">
									Add
								</MudButton>
							</div>
						</div>
					}
				</MudPopover>
			</div>
		</div>

		<div class="d-flex">
			<MudButtonGroup Variant=@Variant.Outlined
							OverrideStyles="false"
							Class="rounded-lg mr-4 transition-all custom-hover-btn custom-header-btn">

				<MudButton OnClick=@ToggleFilterPopover
						   Ripple="false"
						   Class="px-3 border-0 custom-hover-btn"
						   Style="text-transform: none; min-width: 0;">

					<MudIcon Icon=@Icons.Material.Outlined.FilterAlt
							 Size=@Size.Small
							 Class="mr-2"
							 Style="font-size: 1.1rem; color: #475569" />

					<span style="font-size: 0.875rem; font-weight: 500; color: #334155">
						Filter @(HasActiveFilters ? $"({ActiveFiltersCount})" : "")
					</span>

					@if (!HasActiveFilters)
					{
						<MudIcon Icon=@Icons.Material.Rounded.ExpandMore
								 Size=@Size.Small
								 Class="ml-1"
								 Style="font-size: 1.2rem;" />
					}
				</MudButton>

				@if (HasActiveFilters)
				{
					<MudButton OnClick=@ClearAllFiltersAsync
							   Ripple="false"
							   Class="px-2 custom-hover-btn clear-filters-btn">

						<MudIcon Icon=@Icons.Material.Rounded.Close
								 Size=@Size.Small
								 Style="font-size: 1.1rem;" />
					</MudButton>
				}
			</MudButtonGroup>

			<MudPopover Open=@_isFilterPopoverOpen
						AnchorOrigin=@Origin.BottomRight
						TransformOrigin=@Origin.TopRight
						Class="pa-4 pt-2 mud-elevation-25 rounded-lg"
						Style="width: 320px; max-height: 80vh; overflow-y: auto; z-index: 9999;">

				<div class="d-flex justify-space-between align-center mb-2">
					<MudText Typo=@Typo.subtitle1
							 Class="font-weight-bold text-dark">Filter Cards</MudText>

					<MudIconButton Icon=@Icons.Material.Rounded.Close
								   Size=@Size.Small
								   OnClick=@ToggleFilterPopover
								   Class="text-muted" />
				</div>

				<div class="overflow-y-auto custom-scrollbar pr-2 pb-4" style="max-height: 65vh; overflow-x: hidden;">

					<div class="mb-5">
						<MudText Typo=@Typo.caption
								 Class="text-muted font-weight-bold d-block mb-3">
							FILTER BY MEMBER
						</MudText>

						<div class="d-flex flex-wrap gap-2">
							@{
								var displayMembers = _membersFilterExpanded
									? _boardMembers
									: _boardMembers?.Take(VisibleFiltersCount).ToList();
								var hiddenMembersCount = (_boardMembers?.Count ?? 0) - VisibleFiltersCount;

								bool isNoAssigneeSelected = _selectedFilterMembers.Contains(Guid.Empty);
							}

							<MudPaper Elevation="0"
									  Class=@($"filtered-items d-flex align-center rounded-pill px-3 gap-2 border-solid border cursor-pointer {(isNoAssigneeSelected ? "mud-theme-primary mud-border-primary text-white" : "bg-transparent mud-border-lines-default")}")
									  @onclick=@(async () => await ToggleMemberFilter(Guid.Empty))>

								<MudIcon Icon=@Icons.Material.Outlined.PersonOff
										 Size=@Size.Small
										 Style=@($"color: {(isNoAssigneeSelected ? "white" : "#64748b")}; font-size: 1.1rem;") />
								<span style="font-size: 0.8125rem;">No Assignee</span>
							</MudPaper>

							@if (displayMembers != null)
							{
								@foreach (var member in displayMembers)
								{
									bool isSelected = _selectedFilterMembers.Contains(member.Dto.UserId);

									<MudPaper @key=@member.Dto.UserId
											  Elevation="0"
											  Class=@($"filtered-items d-flex align-center rounded-pill px-2 gap-2 border-solid border cursor-pointer {(isSelected ? "mud-theme-primary mud-border-primary" : "bg-transparent mud-border-lines-default")}")
											  @onclick=@(async () => await ToggleMemberFilter(member.Dto.UserId))>

										<MudAvatar Size=@Size.Small
												   Style=@($"font-size: 0.65rem; background-color: {(string.IsNullOrEmpty(member.Dto.AvatarColor) ? "#64748b" : member.Dto.AvatarColor)}; color: white;")>
											@if (!string.IsNullOrEmpty(member.Dto.AvatarUrl))
											{
												<img src=@member.Dto.AvatarUrl
													 alt="Profile Avatar"
													 style="width: 100%; height: 100%; object-fit: cover;" />
											}
											else
											{
												@(member.Dto.Initials ?? "??")
											}
										</MudAvatar>

										<MudText Typo=@Typo.body2
												 Class="text-truncate"
												 Style="max-width: 120px;">
											@member.Dto.FullName
										</MudText>
									</MudPaper>
								}

								@if (!_membersFilterExpanded && hiddenMembersCount > 0)
								{
									<MudPaper Elevation="0"
											  Class="filtered-items d-flex align-center rounded-pill px-3 border-solid border mud-border-lines-default bg-transparent cursor-pointer"
											  @onclick=@(() => _membersFilterExpanded = true)>
										<span style="font-size: 0.8125rem; color: #64748b;">+@hiddenMembersCount</span>
									</MudPaper>
								}
							}
						</div>
					</div>

					<div class="mb-5">
						<MudText Typo=@Typo.caption
								 Class="text-muted font-weight-bold d-block mb-3">
							FILTER BY DUE DATE
						</MudText>

						<div class="d-flex flex-wrap gap-2">

							@foreach (var filter in _dateFilters)
							{
								bool isSelected = _selectedFilterDueDates.Contains(filter.Name);

								<MudPaper @key=@filter.Name
										  Elevation="0"
										  Class=@($"filtered-items d-flex align-center rounded-pill px-3 gap-2 border-solid border cursor-pointer {(isSelected ? "mud-theme-primary mud-border-primary text-white" : "bg-transparent mud-border-lines-default")}")
										  @onclick=@(async () => await ToggleDueDateFilter(filter.Name))>

									<MudIcon Icon=@filter.Icon
											 Size=@Size.Small
											 Style=@($"color: {(isSelected ? "white" : filter.Color)}; font-size: 1.1rem;") />

									<span style="font-size: 0.8125rem;">@filter.Name</span>
								</MudPaper>
							}
						</div>
					</div>

					<div class="mb-2">
						<MudText Typo=@Typo.caption
								 Class="text-muted font-weight-bold d-block mb-3">
							FILTER BY LABEL
						</MudText>

						<div class="d-flex flex-wrap gap-2">
							@{
								var allLabels = BoardUniqueLabels.ToList();
								var displayLabels = _labelsFilterExpanded
									? allLabels
									: allLabels.Take(VisibleFiltersCount).ToList();
								var hiddenLabelsCount = allLabels.Count - VisibleFiltersCount;

								bool isNoLabelSelected = _selectedFilterLabels.Contains(Guid.Empty);
							}

							<MudPaper Elevation="0"
									  Class=@($"filtered-items d-flex align-center rounded-pill px-3 gap-2 border-solid border cursor-pointer {(isNoLabelSelected ? "mud-theme-primary mud-border-primary text-white" : "bg-transparent mud-border-lines-default")}")
									  @onclick=@(async () => await ToggleLabelFilter(Guid.Empty))>

								<MudIcon Icon=@Icons.Material.Outlined.LabelOff
										 Size=@Size.Small
										 Style=@($"color: {(isNoLabelSelected ? "white" : "#64748b")}; font-size: 1.1rem;") />
								<span style="font-size: 0.8125rem;">No Labels</span>
							</MudPaper>

							@foreach (var label in displayLabels)
							{
								bool isSelected = _selectedFilterLabels.Contains(label.Id);
								var mudColor = new MudBlazor.Utilities.MudColor(label.Color ?? "#808080");

								var chipStyle = isSelected
														? $"background-color: rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 1); color: white; border: 1px solid rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 1); height: 32px; cursor: pointer;"
														: $"background-color: rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 0.15); color: rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 1); border: 1px solid rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 0.5); height: 32px; cursor: pointer;";

								var dotColor = isSelected ? "white" : (label.Color ?? "#808080");

								<MudPaper @key=@label.Id
										  Elevation="0"
										  Style=@chipStyle
										  Class="d-flex align-center rounded-pill px-3 py-1 gap-2"
										  @onclick=@(async () => await ToggleLabelFilter(label.Id))>

									<div class="rounded-circle lable-point"
										 style="background-color: @dotColor;">
									</div>

									<span style="font-size: 0.8125rem;">@label.Name</span>
								</MudPaper>
							}

							@if (!_labelsFilterExpanded && hiddenLabelsCount > 0)
							{
								<MudPaper Elevation="0"
										  Class="d-flex align-center rounded-pill px-3 border-solid border mud-border-lines-default bg-transparent cursor-pointer filtered-items"
										  @onclick=@(() => _labelsFilterExpanded = true)>
									<span clas="hidden-labels-count">+@hiddenLabelsCount</span>
								</MudPaper>
							}
						</div>
					</div>

				</div>

			</MudPopover>

			<MudOverlay Visible=@_isFilterPopoverOpen
						OnClick=@ToggleFilterPopover
						AutoClose="true"
						ZIndex="9998" />

			@if (!IsCurrentUserObserver)
			{
				<div class="position-relative">
					<MudButton Variant=@Variant.Outlined
							   OnClick=@OpenReorderPopover
							   Ripple="false"
							   Class="rounded-lg px-2 transition-all custom-hover-btn custom-header-btn">

						<MudIcon Icon=@Icons.Material.Outlined.Layers
								 Size=@Size.Small
								 Class="mr-1"
								 Style="font-size: 1.1rem;" />

						<MudIcon Icon=@Icons.Material.Rounded.MoreHoriz
								 Size=@Size.Small
								 Style="font-size: 1.1rem;" />
					</MudButton>

					<MudPopover Open=@_isReorderPopoverOpen
								AnchorOrigin=@Origin.BottomRight
								TransformOrigin=@Origin.TopRight
								Class="pa-4 pt-2 mud-elevation-25 rounded-lg reorder-popover">

						<div class="d-flex justify-space-between align-center mb-2">
							<MudText Typo=@Typo.subtitle2
									 Class="font-weight-bold">Reorder Sections</MudText>
							<MudIconButton Icon=@Icons.Material.Rounded.Close
										   Size=@Size.Small
										   OnClick=@CloseReorderPopover />
						</div>

						@if (_reorderList.Any())
						{
							<MudText Typo=@Typo.body2
									 Class="text-muted mb-4">
								Drag rows to change the order of sections
							</MudText>

							<MudDropContainer T=@KanbanSectionViewModel
											  Items=@_reorderList
											  ItemDisabled="@(_ => IsCurrentUserObserver)"
											  ItemsSelector=@((item, zone) => true)
											  ItemDropped=@SectionDropped
											  Class="d-flex flex-column mb-4 overflow-y-auto pe-2 reorder-list-container">
								<ChildContent>
									<MudDropZone T=@KanbanSectionViewModel
												 Identifier="reorder-zone"
												 AllowReorder="true"
												 Class="d-flex flex-column gap-2" />
								</ChildContent>
								<ItemRenderer>
									<MudPaper Elevation="0"
											  Class="pa-2 px-3 d-flex align-center border-solid border-2 mud-border-lines-default rounded-lg">
										<MudIcon Icon=@Icons.Material.Rounded.DragIndicator
												 Size=@Size.Small
												 Class="text-muted mr-3" />

										<MudText Typo=@Typo.body2
												 Class="font-weight-medium reorder-item-text">@context.Name</MudText>
										<MudSpacer />

										<MudText Typo=@Typo.caption
												 Class="text-muted">
											@(_tasks.Count(t => t.SectionId == context.Id)) cards
										</MudText>
									</MudPaper>
								</ItemRenderer>
							</MudDropContainer>

							<div class="d-flex gap-2">
								<MudButton Variant=@Variant.Filled
										   Color=@Color.Primary
										   FullWidth="true"
										   Class="rounded-lg text-none custom-btn"
										   OnClick=@ApplySectionOrderAsync>
									Apply Order
								</MudButton>

								<MudButton Variant=@Variant.Filled
										   Color=@Color.Surface
										   FullWidth="true"
										   Class="rounded-lg text-none text-btn"
										   DropShadow="false"
										   OnClick=@CloseReorderPopover>
									Cancel
								</MudButton>
							</div>
						}
						else
						{
							<div class="d-flex flex-column align-center justify-center py-8 text-muted">
								<MudIcon Icon=@Icons.Material.Rounded.ViewList Size=@Size.Large Class="mb-2" />
								<MudText Typo=@Typo.body2>No sections yet. Create one to get started!</MudText>
							</div>
						}
					</MudPopover>
				</div>
			}
		</div>
	</div>

	<MudDropContainer T=@KanbanTaskViewModel
					  @ref=@_dropContainer
					  Items=@FilteredTasks
					  ItemsSelector=@((item, column) => item.SectionId.ToString() == column)
					  ItemDropped=@TaskUpdated
					  Class="d-flex flex-row px-6 pr-15 flex-grow-1 kanban-container">
		<ChildContent>
			@foreach (var item in _sections)
			{
				<MudPaper @key="item.Id"
						  Elevation="0"
						  Width="17rem"
						  Class="pa-4 ma-4 d-flex flex-column rounded-lg kanban-column">
					<MudToolBar Gutters="false"
								Class="mb-2">
						@if (item.IsRenaming)
						{
							<div class="d-flex flex-grow-1 mr-2 align-center rename-wrapper">
								<MudTextField @bind-Value="item.EditName"
											  Underline="false"
											  Margin=@Margin.Dense
											  AutoFocus="true"
											  Class="rename-input"
											  MaxLength="50" />
							</div>

							<MudIconButton Icon=@Icons.Material.Rounded.Check
										   Size=@Size.Small
										   Color=@Color.Success
										   OnClick=@(() => SaveRename(item)) />

							<MudIconButton Icon=@Icons.Material.Rounded.Close
										   Size=@Size.Small
										   OnClick=@(() => item.IsRenaming = false) />
						}
						else
						{
							<MudText Typo=@Typo.subtitle1
									 Class="section-title">
								<b>@item.Name</b>
							</MudText>
							<MudSpacer />
							@if (!IsCurrentUserObserver)
							{
								<MudMenu Icon=@Icons.Material.Rounded.MoreHoriz
										 @bind-Open="item.MenuOpen"
										 AnchorOrigin=@Origin.BottomRight
										 TransformOrigin=@Origin.TopRight
										 ListClass="pa-2 d-flex flex-column"
										 PopoverClass="mud-elevation-25 rounded-lg px-2">

									<div @onclick:stopPropagation="true">
										@if (item.IsConfirmingDelete)
										{
											<MudButton Size=@Size.Small
													   Color=@Color.Error
													   Variant=@Variant.Filled
													   DropShadow="false"
													   Class="w-100 justify-start mb-1"
													   StartIcon=@Icons.Material.Filled.DeleteForever
													   OnClick=@(() => DeleteSection(item))>
												Confirm Delete
											</MudButton>
										}
										else
										{
											<MudButton Size=@Size.Small
													   Color=@Color.Error
													   Class="w-100 justify-start mb-1"
													   StartIcon=@Icons.Material.Outlined.Delete
													   OnClick=@(() => item.IsConfirmingDelete = true)>
												Delete
											</MudButton>
										}
									</div>

									<MudButton Size=@Size.Small
											   Color=@Color.Default
											   Class="w-100 justify-start"
											   StartIcon=@Icons.Material.Rounded.Edit
											   OnClick=@(() => StartRename(item))>
										Rename
									</MudButton>
								</MudMenu>
							}
						}
					</MudToolBar>

					<MudDropZone T=@KanbanTaskViewModel
								 Identifier=@item.Id.ToString()
								 Class="flex-grow-1 pb-4 drop-zone"
								 AllowReorder="@(!IsCurrentUserObserver)" />
					@if (item.NewTaskOpen && !IsCurrentUserObserver)
					{
						<MudPaper Elevation="1"
								  Class="pa-2 rounded-lg mt-2">
							<MudTextField @bind-Value="item.NewTaskName"
										  Placeholder="Enter card title..."
										  Underline="false"
										  Margin=@Margin.Dense
										  MaxLength="100"
										  Class="mx-1 mb-2">
							</MudTextField>

							<div class="d-flex align-center justify-space-between gap-1">
								<MudButton OnClick=@(() => AddTask(item))
										   Variant=@Variant.Filled
										   Size=@Size.Small
										   Class="rounded-lg text-none px-3 custom-btn">
									Add Card
								</MudButton>

								<MudIconButton Icon=@Icons.Material.Rounded.Close
											   Size=@Size.Small
											   Class="text-muted"
											   OnClick=@(() => CloseNewTaskForm(item)) />
							</div>
						</MudPaper>
					}
					else
					{
						@if (!IsCurrentUserObserver)
						{
							<MudButton OnClick=@(() => item.NewTaskOpen = !item.NewTaskOpen)
									   StartIcon=@Icons.Material.Filled.Add
									   FullWidth="true"
									   Class="rounded-lg py-2 justify-start px-3 add-card-btn-empty">
								Add Card
							</MudButton>
						}
					}
				</MudPaper>
			}

			@if (!IsCurrentUserObserver)
			{
				<MudPaper Class="pa-4 add-section-wrapper"
						  Elevation="0"
						  Width="17rem">
					@if (_addSectionOpen)
					{
						<MudPaper Elevation="0"
								  Width="17rem"
								  Class="pa-4 d-flex flex-column mud-background-gray rounded-lg add-section-form-wrapper">
							<EditForm Model=@newSectionModel
									  OnValidSubmit=@OnValidSectionSubmit
									  Class="add-section-form-wrapper">
								<DataAnnotationsValidator />

								<MudTextField @bind-Value="newSectionModel.Name"
											  For=@(() => newSectionModel.Name)
											  Placeholder="New section"
											  Underline="false"
											  Class="mb-4"
											  MaxLength="50">
								</MudTextField>

								<div class="d-flex align-center justify-space-between gap-1">
									<MudButton ButtonType=@ButtonType.Submit
											   Variant=@Variant.Filled
											   Size=@Size.Small
											   Class="rounded-lg text-none px-3 custom-btn">
										Add section
									</MudButton>

									<MudIconButton Icon=@Icons.Material.Rounded.Close
												   Size=@Size.Small
												   Class="text-muted"
												   OnClick=@CloseAddNewSection />
								</div>
							</EditForm>
						</MudPaper>
					}
					else
					{
						<MudButton OnClick=@OpenAddNewSection
								   StartIcon=@Icons.Material.Filled.Add
								   DisableElevation="true"
								   Class="rounded-lg py-2 px-5 text-none add-section-btn">
							Add Section
						</MudButton>
					}
				</MudPaper>
			}
		</ChildContent>

		<ItemRenderer>
			<MudPaper Elevation="0"
					  Class="pa-3 rounded-lg my-3 task-item cursor-pointer d-flex flex-column"
					  Style="box-shadow: 0 1px 2px rgba(0,0,0,0.05), 0 1px 4px rgba(0,0,0,0.05) !important; border: 1px solid #e2e8f0; transition: transform 0.1s, box-shadow 0.1s;"
					  @onclick=@(() => OpenCardDetails(context))>

				@if (context.Labels != null && context.Labels.Any())
				{
					<div class="d-flex flex-wrap gap-2 mb-2">
						@foreach (var label in context.Labels)
						{
							var mudColor = new MudBlazor.Utilities.MudColor(label.Color ?? "#808080");
							var chipStyle = $"background-color: rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 0.15); color: rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 1); border: 1px solid rgba({mudColor.R}, {mudColor.G}, {mudColor.B}, 0.5); font-weight: 400; font-size: 0.75rem; height: 24px;";

							<MudChip T="string"
									 Size=@Size.Small
									 Class="ma-0 rounded-pill px-2"
									 Style=@chipStyle>
								@label.Name
							</MudChip>
						}
					</div>
				}

				<MudText Typo=@Typo.body1
						 Class="font-weight-regular mb-2"
						 Style="font-size: 0.95rem; line-height: 1.4; color: #1e293b;">
					@context.Name
				</MudText>

				@if (context.DueDate.HasValue)
				{
					bool isOverdue = context.DueDate.Value < DateTime.Now;
					string themeColor = isOverdue ? "#ef4444" : "#f97316";
					var dateIcon = isOverdue ? Icons.Material.Outlined.ErrorOutline : Icons.Material.Outlined.AccessTime;

					<div class="d-flex align-center rounded px-1 mb-2"
						 style="background-color: @(themeColor)15; color: @(themeColor); width: fit-content; height: 22px;">

						<MudIcon Icon=@dateIcon
								 Style="font-size: 14px; margin-right: 4px;" />

						<span style="font-size: 0.75rem; font-weight: 500; line-height: 1;">
							@context.DueDate.Value.ToString("dd MMM")
						</span>
					</div>
				}

				@if (context.ChecklistTotalItems > 0)
				{
					bool isChecklistDone = context.ChecklistDoneItems == context.ChecklistTotalItems;

					var progressColor = isChecklistDone ? Color.Success : Color.Info;
					string iconColor = isChecklistDone ? "#10b981" : "#64748b";

					<div class="d-flex flex-column gap-1 mb-3">
						<div class="d-flex align-center" style="font-size: 0.75rem; font-weight: 500; color: #94a3b8;">
							<MudIcon Icon=@Icons.Material.Outlined.CheckBox
									 Size=@Size.Small
									 Style=@($"font-size: 15px; margin-right: 4px; color: {iconColor};") />
							<span>@context.ChecklistDoneItems/@context.ChecklistTotalItems</span>
						</div>

						<MudProgressLinear Color=@progressColor
										   Size=@Size.Small
										   Value=@((double)context.ChecklistDoneItems / context.ChecklistTotalItems * 100)
										   Class="rounded-pill"
										   Style="height: 4px; background-color: #e2e8f0;" />
					</div>
				}

				<div class="d-flex align-center justify-space-between mt-auto pt-1">

					<div class="d-flex align-center gap-3 text-muted"
						 style="font-size: 0.75rem; font-weight: 500; color: #94a3b8 !important;">
						@if (context.AttachmentsCount > 0)
						{
							<div class="d-flex align-center gap-1">
								<MudIcon Icon=@Icons.Material.Outlined.AttachFile
										 Style="font-size: 14px;" />
								<span>@context.AttachmentsCount</span>
							</div>
						}
						@if (context.CommentsCount > 0)
						{
							<div class="d-flex align-center gap-1">
								<MudIcon Icon=@Icons.Material.Outlined.ModeComment
										 Style="font-size: 14px;" />
								<span>@context.CommentsCount</span>
							</div>
						}
					</div>

					@if (context.Assignees != null && context.Assignees.Any())
					{
						<MudAvatarGroup Max="3"
										Spacing="2"
										MaxColor=@Color.Dark>
							@foreach (var assignee in context.Assignees)
							{
								<MudAvatar Size="@Size.Small"
										   Class="member-avatar-small"
										   Style=@($"background-color: {(string.IsNullOrEmpty(assignee.AvatarColor) ? "#64748b" : assignee.AvatarColor)}; color: white;")>
									@if (!string.IsNullOrEmpty(assignee.AvatarUrl))
									{
										<img src=@assignee.AvatarUrl
											 alt="Profile Avatar"
											 style="width: 100%; height: 100%; object-fit: cover;" />
									}
									else
									{
										@(assignee.Initials ?? "??")
									}
								</MudAvatar>
							}
						</MudAvatarGroup>
					}
				</div>
			</MudPaper>
		</ItemRenderer>
	</MudDropContainer>
</div>
@using Microsoft.AspNetCore.Authorization

@page "/login"

@layout EmptyLayout

@attribute [AllowAnonymous]

<div class="split-screen">

    <div class="left-panel">

        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-briefcase-fill logo-iconlogo-icon"></i>
            <span class="h4 mb-0 fw-bold tracking-wide">WorkBoard</span>
        </div>

        <div class="my-auto marketing-content">
            <h1 class="display-4 fw-bold text-white mb-4">
                Your team's<br />command center.
            </h1>

            <p class="text-white-50 lead mb-5">
                Boards, roles and AI assistance — all in one place.
            </p>

            <ul class="list-unstyled d-flex flex-column gap-3">
                @foreach (var feature in Features)
                {
                    <li class="d-flex align-items-center gap-3 text-white-75">
                        <i class="bi bi-check-circle-fill text-info"></i> @feature
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="right-panel">
        <div class="auth-box">
            <h2 class="auth-title">Get started</h2>

            <p class="auth-subtitle">Choose how you'd like to continue.</p>

            <button class="btn-login" 
                    @onclick=@SignIn>
                <span>Sign In / Register</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</div>
